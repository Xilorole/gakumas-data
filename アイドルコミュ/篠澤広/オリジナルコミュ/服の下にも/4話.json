{
  "session": "hiro_original_fuku_no_shita_nimo_4",
  "title": "4話",
  "idol": "篠澤広",
  "comm_type": "オリジナルコミュ",
  "exported_at": "2026-10-13T14:18:18.479829+00:00",
  "line_count": 39,
  "needs_review": 0,
  "lines": [
    {
      "index": 1,
      "type": "dialogue",
      "text": "4．さらに後日・事務所"
    },
    {
      "index": 2,
      "type": "dialogue",
      "speaker": "広",
      "text": "お疲れさま。"
    },
    {
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "お疲れさまです。\nピアスを開けた、という連絡は読みました。",
      "index": 3
    },
    {
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "その後はどうです？",
      "index": 4
    },
    {
      "index": 5,
      "type": "dialogue",
      "speaker": "広",
      "text": "相談したとおりにしてる。\n次の確認にも、行く。"
    },
    {
      "index": 6,
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "分かりました。こちらの予定も、\n相談した内容で進めています。"
    },
    {
      "index": 7,
      "type": "dialogue",
      "speaker": "広",
      "text": "ありがとう。……それで、別の報告。"
    },
    {
      "type": "dialogue",
      "speaker": "広",
      "text": "昨日、帰ってから、鏡を見た。",
      "index": 8
    },
    {
      "index": 9,
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "はい。"
    },
    {
      "index": 10,
      "type": "dialogue",
      "speaker": "広",
      "text": "撮影の照明も、衣装も、なかった。"
    },
    {
      "index": 11,
      "type": "dialogue",
      "speaker": "広",
      "text": "……あった。"
    },
    {
      "index": 12,
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "それは、あるでしょう。"
    },
    {
      "index": 13,
      "type": "dialogue",
      "speaker": "広",
      "text": "知ってる。わたしが、そうしたんだから。"
    },
    {
      "index": 14,
      "type": "dialogue",
      "speaker": "広",
      "text": "でも、ほんとに、家までついてきた。"
    },
    {
      "index": 15,
      "type": "dialogue",
      "speaker": "広",
      "text": "変な感じ。着替えたら、なくなるのに、\n慣れてた。"
    },
    {
      "index": 16,
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "昨日は、持って帰れた。"
    },
    {
      "index": 17,
      "type": "dialogue",
      "speaker": "広",
      "text": "うん。……持って帰れた。"
    },
    {
      "index": 18,
      "type": "dialogue",
      "speaker": "広",
      "text": "これ。見せてもいい写真、撮った。"
    },
    {
      "index": 19,
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "拝見します。"
    },
    {
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "いいですね。普段の服にも、\nその水色がよく合っています。",
      "index": 20
    },
    {
      "index": 21,
      "type": "dialogue",
      "speaker": "広",
      "text": "……かわいい？"
    },
    {
      "index": 22,
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "はい。よく似合っています。"
    },
    {
      "index": 23,
      "type": "dialogue",
      "speaker": "広",
      "text": "うん。……わたしも、そう思った。"
    },
    {
      "index": 24,
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "嬉しそうですね。"
    },
    {
      "index": 25,
      "type": "dialogue",
      "speaker": "広",
      "text": "昨日、家で見たときは、もっと。"
    },
    {
      "index": 26,
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "それは見たかった。"
    },
    {
      "index": 27,
      "type": "dialogue",
      "speaker": "広",
      "text": "……そっちは、撮ってない。"
    },
    {
      "index": 28,
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "残念です。"
    },
    {
      "index": 29,
      "type": "dialogue",
      "speaker": "広",
      "text": "写真、送ってもいい？"
    },
    {
      "index": 30,
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "もちろん。"
    },
    {
      "index": 31,
      "type": "dialogue",
      "speaker": "広",
      "text": "衣装の資料にする方じゃなくて。"
    },
    {
      "index": 32,
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "広さんからの報告として、受け取ります。"
    },
    {
      "type": "dialogue",
      "speaker": "広",
      "text": "うん。……いま、送った。",
      "index": 33
    },
    {
      "index": 34,
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "……二枚？"
    },
    {
      "index": 35,
      "type": "dialogue",
      "speaker": "広",
      "text": "こっちは、すこし横から。"
    },
    {
      "index": 36,
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "なるほど。"
    },
    {
      "index": 37,
      "type": "dialogue",
      "speaker": "広",
      "text": "三枚目も、ある。"
    },
    {
      "index": 38,
      "type": "dialogue",
      "speaker": "プロデューサー",
      "text": "選んで持ってきたんですね。"
    },
    {
      "index": 39,
      "type": "dialogue",
      "speaker": "広",
      "text": "うん。まだ、見て。"
    }
  ]
}
