  "lines": [
    {
      "index": 1,
      "type": "dialogue",
      "speaker": "佑芽",
      "text": "広ちゃん！"
    },
    {
      "index": 2,
      "type": "dialogue",
      "speaker": "佑芽",
      "text": "あたしの負一一一"
    },
    {
      "index": 3,
      "type": "dialogue",
      "speaker": "佑芽",
      "text": "ええええええええーーーーツ！？"
    },
    {
      "index": 4,
      "type": "dialogue",
      "speaker": "広",
      "text": "はぁ……はぁ……はぁ…………っ。"
    },
    {
      "index": 5,
      "type": "dialogue",
      "speaker": "佑芽",
      "text": "ひ、広ちゃん大丈夫！？"
    },
    {
      "index": 6,
      "type": "dialogue",
      "speaker": "広",
      "text": "……九死に一生を得た。"
    },
    {
      "index": 7,
      "type": "dialogue",
      "speaker": "佑芽",
      "text": "アイドルやってて、そんな人台詞を\n聞くことになるとは思わなかったよ！"
    },
    {
      "index": 8,
      "type": "dialogue",
      "speaker": "広",
      "text": "……運んでくれてありがとう、佑芽。"
    },
    {
      "index": 9,
      "type": "dialogue",
      "speaker": "佑芽",
      "text": "どういたしましてっ。\n……ほんとに大丈夫？"
    },
    {
      "index": 10,
      "type": "dialogue",
      "speaker": "広",
      "text": "すこし大丈夫。\n死にはしない。手馴れたもの。"
    },
    {
      "index": 11,
      "type": "dialogue",
      "speaker": "佑芽",
      "text": "ちっとも安心できないいぃっ！"
    },
    {
      "index": 12,
      "type": "dialogue",
      "speaker": "広",
      "text": "ふふ……けっこう体力ついて\nきたと思ってたけど。"
    },
    {
      "index": 13,
      "type": "dialogue",
      "speaker": "広",
      "text": "佑芽が強敵すぎて……\n限界を超えちゃった。"
    },
    {
      "index": 14,
      "type": "dialogue",
      "speaker": "佑芽",
      "text": "……あたしの負けだね。広ちゃん。"
    },
    {
      "index": 15,
      "type": "dialogue",
      "speaker": "佑芽",
      "text": "ほんとうにすごかった。"
    },
    {
      "index": 16,
      "type": "dialogue",
      "speaker": "広",
      "text": "……佑芽。"
    },
    {
      "index": 17,
      "type": "dialogue",
      "speaker": "広",
      "text": "わたし、泣きそう。"
    },
    {
      "index": 18,
      "type": "dialogue",
      "speaker": "佑芽",
      "text": "なんで！？"
    },
    {
      "index": 19,
      "type": "dialogue",
      "speaker": "広",
      "text": "佑芽と千奈は、\nわたしのはじめての友達。"
    },
    {
      "index": 20,
      "type": "dialogue",
      "speaker": "広",
      "text": "佑芽は、わたしがはじめて\nライブを観た……本物のアイドル。"
    },
    {
      "index": 21,
      "type": "dialogue",
      "speaker": "広",
      "text": "佑芽は……わたしの憧れ。"
    },
    {
      "index": 22,
      "type": "dialogue",
      "speaker": "広",
      "text": "佑芽は……佑芽は……"
    },
    {
      "index": 23,
      "type": "dialogue",
      "speaker": "広",
      "text": "わたしの……ライバル。"
    },
    {
      "index": 24,
      "type": "dialogue",
      "speaker": "佑芽",
      "text": "……………………………………………………"
    },
    {
      "index": 25,
      "type": "dialogue",
      "speaker": "佑芽",
      "text": "また、勝負しようね。\n何度でも、勝負しようね。"
    },
    {
      "index": 26,
      "type": "dialogue",
      "speaker": "佑芽",
      "text": "負けっぱなしは、くやしいもん！"
    },
    {
      "index": 27,
      "type": "dialogue",
      "speaker": "広",
      "text": "佑芽、約束、覚えてる？"
    },
    {
      "index": 28,
      "type": "dialogue",
      "speaker": "佑芽",
      "text": "えっ？　あっ一一"
    },
    {
      "index": 29,
      "type": "dialogue",
      "speaker": "広",
      "text": "ふぅ～～～～～～～～～～っ。"
    },
    {
      "index": 30,
      "type": "dialogue",
      "speaker": "佑芽",
      "text": "こ、こんにゃろ～～～～～～～っ！"
    }
  ]
}
